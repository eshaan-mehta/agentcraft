# Anthropic credentials. Not needed if you've logged in with the Anthropic CLI
# (`ant auth login`); the SDK picks that profile up automatically. Otherwise set a key
# from https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=

# Claude settings. claude-sonnet-5-5 is a good balance; claude-haiku-5-5 is fastest and
# cheapest (about 20x less); claude-opus-5-5 is strongest.
AGENT_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Lower is faster and cheaper per step.
AGENT_EFFORT=medium

# How readily the bot asks you for guidance: often | stuck | rarely (change live with /ask)
ASK_MODE=stuck

# Comma-separated names whose chat counts as instructions. Empty = anyone on the server.
SUPERVISORS=

# Send you the agent's plan, and each change to it, as private messages in game
PLAN_IN_CHAT=on

# Survival reflexes (fight, flee, eat, armor) always run. With this on, survival needs
# (night is coming, no food, just died) also wake Claude when it has no task.
SURVIVAL_AUTONOMY=on

# Resume the previous conversation when the agent restarts (it's saved after every step)
RESUME_SESSION=on

# Longest a script the bot writes may run, in seconds
MAX_SCRIPT_SECONDS=180

# Minecraft connection. The defaults match the local server from `npm run server:setup`.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.21.11
BOT_USERNAME=Claude
# offline for local/offline-mode servers; microsoft to log the bot in with its own account
MC_AUTH=offline

# The local dashboard (npm run dashboard). Running agents publish their status to RUNTIME_DIR
# and read messages sent from the dashboard there. The dashboard only listens on 127.0.0.1.
RUNTIME_DIR=runtime
DASHBOARD_PORT=4321
